{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@muster/core": ["./packages/core/src/index.ts"],
      "@muster/pdf": ["./packages/pdf/src/index.ts"],
      "@muster/backend": ["./apps/web/src/backend/http.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"]
}
