{
  "name": "muster",
  "version": "1.0.1",
  "private": true,
  "description": "Incident response playbooks: visual editor, guided runs, version history and incident reports.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "node scripts/build.mjs --watch",
    "demo": "node scripts/build.mjs && node scripts/demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node --test tests/api.test.mjs",
    "test:e2e": "node scripts/build.mjs && node tests/e2e.mjs",
    "build:online": "node scripts/build-online.mjs",
    "test:online": "node scripts/build-online.mjs && node tests/online.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
